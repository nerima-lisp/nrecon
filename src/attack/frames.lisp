(in-package #:nrecon.attack)

(defun %check-octets (bytes)
  (unless (typep bytes '(vector (unsigned-byte 8)))
    (error "Packet bytes must be an octet vector, got ~S." (type-of bytes)))
  bytes)

(defun %u16 (value)
  (check-type value (integer 0 65535))
  (vector (ldb (byte 8 8) value)
          (ldb (byte 8 0) value)))

(defun %u32 (value)
  (check-type value (integer 0 #xffffffff))
  (vector (ldb (byte 8 24) value)
          (ldb (byte 8 16) value)
          (ldb (byte 8 8) value)
          (ldb (byte 8 0) value)))

(defun %split-on-character (string separator)
  (loop with start = 0
        for end = (position separator string :start start)
        collect (subseq string start end)
        while end
        do (setf start (1+ end))))

(defun %hex-nibble (character)
  (let ((code (char-code character)))
    (cond
      ((<= 48 code 57) (- code 48))
      ((<= 65 code 70) (+ 10 (- code 65)))
      ((<= 97 code 102) (+ 10 (- code 97)))
      (t nil))))

(defun %hex-octet (string start)
  (let ((high (%hex-nibble (char string start)))
        (low (%hex-nibble (char string (1+ start)))))
    (when (and high low)
      (+ (* 16 high) low))))

(defun %mac-octets (address)
  (check-type address string)
  (unless (and (= (length address) 17)
               (loop for start from 0 below 17 by 3
                     always (and (%hex-octet address start)
                                 (or (= start 15)
                                     (char= (char address (+ start 2)) #\:)))))
    (error "Invalid MAC address: ~S." address))
  (coerce (loop for start from 0 below 17 by 3
                collect (%hex-octet address start))
          '(vector (unsigned-byte 8))))

(defun %ipv4-octets (address)
  (unless (stringp address)
    (error "IPv4 address must be a string, got ~S." address))
  (let ((parts (%split-on-character address #\.)))
    (unless (and (= (length parts) 4)
                 (every (lambda (part)
                          (and (plusp (length part))
                               (every #'digit-char-p part)
                               (<= (parse-integer part) 255)))
                        parts))
      (error "Invalid IPv4 address: ~S." address))
    (map '(vector (unsigned-byte 8)) #'parse-integer parts)))

(defun %concat-octets (&rest vectors)
  (apply #'concatenate '(vector (unsigned-byte 8)) vectors))

(defun %internet-checksum (bytes)
  (%check-octets bytes)
  (let ((sum 0))
    (loop for index from 0 below (length bytes) by 2
          for word = (+ (ash (aref bytes index) 8)
                        (if (< (1+ index) (length bytes))
                            (aref bytes (1+ index))
                            0))
          do (incf sum word)
             (setf sum (+ (logand sum #xffff) (ash sum -16))))
    (logand #xffff (lognot (+ (logand sum #xffff) (ash sum -16))))))

(defun %encode-dns-name (name)
  (unless (and (stringp name) (plusp (length name)) (<= (length name) 253))
    (error "Invalid DNS name: ~S." name))
  (let ((labels (%split-on-character (string-downcase name) #\.)))
    (unless (every (lambda (label)
                     (and (<= 1 (length label) 63)
                          (not (char= (char label 0) #\-))
                          (not (char= (char label (1- (length label))) #\-))
                          (every (lambda (character)
                                   (or (char<= #\a character #\z)
                                       (char<= #\0 character #\9)
                                       (char= character #\-)))
                                 label)))
                   labels)
      (error "Invalid DNS name: ~S." name))
    (let ((encoded
            (coerce
             (append (mapcan (lambda (label)
                               (cons (length label)
                                     (map 'list #'char-code label)))
                             labels)
                     (list 0))
             '(vector (unsigned-byte 8)))))
      (when (> (length encoded) 255)
        (error "Encoded DNS name is too long: ~S." name))
      encoded)))

(defun build-arp-reply (&key source-mac source-ip target-mac target-ip)
  "Build an Ethernet ARP reply frame without opening an interface."
  (let ((source-hardware (%mac-octets source-mac))
        (source-protocol (%ipv4-octets source-ip))
        (target-hardware (%mac-octets target-mac))
        (target-protocol (%ipv4-octets target-ip)))
    (%concat-octets
     target-hardware source-hardware (vector #x08 #x06)
     (vector #x00 #x01 #x08 #x00 #x06 #x04 #x00 #x02)
     source-hardware source-protocol target-hardware target-protocol)))

(defun build-dns-response-frame (&key source-mac source-ip target-mac target-ip
                                      query-name (identifier 0) (source-port 53)
                                      (destination-port 53000) (answer-ttl 60)
                                      answer-ip)
  "Build a single-answer DNS A response in an Ethernet/IPv4/UDP frame."
  (let* ((source-hardware (%mac-octets source-mac))
         (target-hardware (%mac-octets target-mac))
         (source-address (%ipv4-octets source-ip))
         (target-address (%ipv4-octets target-ip))
         (answer-address (%ipv4-octets answer-ip))
         (encoded-name (%encode-dns-name query-name))
         (question (%concat-octets encoded-name (vector 0 1 0 1)))
         (answer (%concat-octets (vector #xc0 #x0c 0 1 0 1)
                                 (%u32 answer-ttl) (vector 0 4) answer-address))
         (dns (%concat-octets (%u16 identifier) (vector #x81 #x80)
                              (vector 0 1 0 1 0 0 0 0) question answer))
         (udp-length (+ 8 (length dns)))
         (udp (%concat-octets (%u16 source-port) (%u16 destination-port)
                              (%u16 udp-length) (vector 0 0)))
         (ip-length (+ 20 udp-length))
         (ip-header
           (%concat-octets (vector #x45 0) (%u16 ip-length) (%u16 0)
                           (vector #x40 0 64 17 0 0)
                           source-address target-address))
         (checksum (%u16 (%internet-checksum ip-header)))
         (ethernet (%concat-octets target-hardware source-hardware
                                   (vector #x08 #x00))))
    (replace ip-header checksum :start1 10)
    (%concat-octets ethernet ip-header udp dns)))
(defun %read-u16 (bytes offset)
  (unless (and (<= 0 offset) (<= (+ offset 2) (length bytes)))
    (error "Truncated network header."))
  (+ (ash (aref bytes offset) 8)
     (aref bytes (1+ offset))))
(defun %ipv4-address-string (address)
  (unless (= (length address) 4)
    (error "An IPv4 address must contain four octets."))
  (format nil "~D.~D.~D.~D"
          (aref address 0)
          (aref address 1)
          (aref address 2)
          (aref address 3)))
(defun %ipv4-literal-octets (address)
  (when (stringp address)
    (let ((parts (%split-on-character address #\.)))
      (when (and (= (length parts) 4)
                 (every (lambda (part)
                          (and (<= 1 (length part) 3)
                               (or (= (length part) 1)
                                   (char/= (char part 0) #\0))
                               (every (lambda (character)
                                        (char<= #\0 character #\9))
                                      part)
                               (<= (parse-integer part) 255)))
                        parts))
        (%ipv4-octets address)))))

(defun rewrite-l2-frame (bytes source-mac destination-mac)
  "Copy an Ethernet frame while replacing only its source and destination MACs."
  (%check-octets bytes)
  (unless (>= (length bytes) 14)
    (error "Ethernet frame is shorter than its 14-byte header."))
  (let ((rewritten (copy-seq bytes)))
    (replace rewritten (%mac-octets destination-mac) :start1 0)
    (replace rewritten (%mac-octets source-mac) :start1 6)
    rewritten))
(defun %transport-header-valid-p (bytes ip-offset ip-total-length protocol)
  (let* ((payload-offset (+ ip-offset 20))
         (payload-length (- ip-total-length 20)))
    (case protocol
      (6
       (and (>= payload-length 20)
            (let ((header-length
                    (ash (logand (aref bytes (+ payload-offset 12)) #xf0) -4)))
              (and (>= header-length 20)
                   (<= header-length payload-length)))))
      (17
       (and (>= payload-length 8)
            (= (%read-u16 bytes (+ payload-offset 4)) payload-length)))
      (otherwise nil))))
(defun %frame-destination-address (bytes)
  "Return the canonical IPv4 destination and octets for a supported Ethernet frame.
Supports untagged Ethernet II, IPv4 without options or fragmentation, and TCP
or UDP. DNS payloads remain opaque and are authorized by the outer IPv4
destination. Rejects ARP, IPv6, VLAN, other transports, and malformed frames."
  (%check-octets bytes)
  (unless (>= (length bytes) 34)
    (error "Unsupported or truncated Ethernet/IPv4 frame."))
  (unless (= (%read-u16 bytes 12) #x0800)
    (error "Unsupported Ethernet type for attack authorization."))
  (let* ((ip-offset 14)
         (version-and-length (aref bytes ip-offset))
         (version (ash version-and-length -4))
         (header-length (* (logand version-and-length #x0f) 4))
         (total-length (%read-u16 bytes (+ ip-offset 2)))
         (fragment-field (%read-u16 bytes (+ ip-offset 6)))
         (protocol (aref bytes (+ ip-offset 9))))
    (unless (and (= version 4) (= header-length 20))
      (error "Unsupported IPv4 version or header options."))
    (unless (and (>= total-length header-length)
                 (<= (+ ip-offset total-length) (length bytes)))
      (error "Malformed or truncated IPv4 packet."))
    (when (logtest fragment-field #xbfff)
      (error "Fragmented or reserved IPv4 packet is unsupported."))
    (unless (member protocol '(6 17))
      (error "Unsupported IPv4 transport protocol."))
    (unless (%transport-header-valid-p bytes ip-offset total-length protocol)
      (error "Malformed or truncated IPv4 transport header."))
    (let ((destination (subseq bytes (+ ip-offset 16) (+ ip-offset 20))))
      (values (%ipv4-address-string destination) destination))))
