(in-package #:nrecon.wire)

(defun %json-value (value)
  (cond
    ((or (eq value json-kit:+json-null+)
         (eq value json-kit:+json-false+))
     value)
    ((null value) json-kit:+json-null+)
    ((eq value t) t)
    ((symbolp value) (string-downcase (symbol-name value)))
    ((or (numberp value) (stringp value)) value)
    ((hash-table-p value)
     (let ((copy (make-hash-table :test #'equal :size (hash-table-count value))))
       (maphash (lambda (key item)
                  (unless (stringp key)
                    (error "JSON object keys must be strings, got ~S." key))
                  (setf (gethash (copy-seq key) copy) (%json-value item)))
                value)
       copy))
    ((vectorp value) (map 'vector #'%json-value value))
    ((consp value) (map 'vector #'%json-value value))
    (t (error "Unsupported JSON value: ~S." value))))
